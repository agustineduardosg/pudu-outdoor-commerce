# Aplicación
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://pudu:pudu_local@localhost:5432/pudu
PUDU_DEMO_MODE=true

# Autenticación y cifrado (generar valores aleatorios; nunca reutilizar)
AUTH_SECRET=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_TOTP_ENCRYPTION_KEY=

# Mercado Pago (solo sandbox en v1)
MERCADO_PAGO_MODE=sandbox
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Worker
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=25
WORKER_MAX_ATTEMPTS=8
WORKER_LOCK_TIMEOUT_MS=600000

# Cloudflare R2
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Correo y observabilidad
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Analítica pública; se carga únicamente después del consentimiento
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
